APP_ENV=local
API_DEBUG=false

GCP_PROJECT_ID=secure-file-processing
FIRESTORE_DATABASE=dev-db
AUTH_REPOSITORY_BACKEND=firestore
GCS_BUCKET_NAME=

QUARANTINE_PREFIX=quarantine/
TRUSTED_PREFIX=trusted/
MAX_FILE_SIZE=52428800
SUPPORTED_FILE_EXTENSIONS=[".jpeg",".jpg",".png",".txt",".zip"]

QUEUE_NAME=
WORKER_ENDPOINT=

# Generate a strong random value for deployed environments.
JWT_SECRET_KEY=local-development-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=secure-file-processing-api
JWT_AUDIENCE=secure-file-processing-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
